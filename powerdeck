#!/bin/sh
set -eu

PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CANDIDATE="$PROJECT/native/qt/build/powerdeck-native"

if [ ! -x "$CANDIDATE" ]; then
    printf '%s\n' "PowerDeck native GUI is not built: $CANDIDATE" >&2
    printf '%s\n' "Run: $PROJECT/native/scripts/build-release.sh" >&2
    exit 1
fi

exec "$CANDIDATE" "$@"
